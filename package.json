{
  "name": "receiptful",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -r \"next dev\" \"convex dev\"",
    "dev:web": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "deploy": "convex deploy --cmd 'next build'",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx convex/model/lib.test.ts",
    "verify": "npm run typecheck && npm test && NEXT_PUBLIC_CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL:-https://placeholder.convex.cloud} npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.94",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "1.3.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "convex": "^1.45.0",
    "lucide-react": "^0.454.0",
    "next": "^15.5.25",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
