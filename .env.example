# =============================================================================
# Receiptful — environment configuration
# Copy to `.env.local` for local development. In production set these on the
# Convex deployment (`npx convex env set --prod ...`) or on the hosting
# provider (Vercel, Netlify, etc.). Never commit a populated `.env.local`.
# =============================================================================

# ---------- Frontend (Vercel / host) ----------------------------------------
# Public URL of the Convex deployment. Safe to expose to the browser; Convex
# scopes every call by signed JWT.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Where Convex Auth redirects password-reset emails and OAuth callbacks. Must
# be the exact origin the user sees in their address bar (no trailing slash,
# no path). Set this on the Convex deployment too (see below).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Convex backend --------------------------------------------------
# Visible only to the Convex CLI; pick up automatically when you run
# `npx convex dev`. Not used in production builds.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Set on the *Convex deployment* (not the host) with:
#   npx convex env set SITE_URL https://your-domain.com
# The web app's public origin. Drives auth redirects and email links.
SITE_URL=http://localhost:3000

# Convex Auth JWT keypair. Generate per environment with the snippet in
# DEPLOYMENT.md step 2. The private key signs tokens, the JWKS is what the
# Next.js server hands out to verify them.
JWT_PRIVATE_KEY=
JWKS=

# ---------- Optional: automatic OCR ----------------------------------------
# Leave unset to run the app with manual receipt entry only. The OCR action
# in `convex/ocr.ts` detects the missing key and routes uploads to the
# review queue with a clear notice — the product never silently breaks.
ANTHROPIC_API_KEY=

# ---------- Optional: self-serve billing ------------------------------------
# Plan changes grant real entitlements (seats and storage) and nothing here
# captures payment, so self-serve upgrades are refused unless this is "1".
# Set it for demos and self-hosting; leave it unset in front of real users
# until a payment provider is wired up.
BILLING_SELF_SERVE=

# ---------- Optional: transactional email ----------------------------------
# Used for the password-reset flow. Without these, the forgot-password page
# shows a "no email provider configured" message instead of a generic error.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Receiptful <noreply@your-domain.com>"
